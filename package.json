{
  "name": "pr-review-assistant",
  "version": "0.1.0",
  "description": "AI-powered Pull Request review assistant — fetches PR changes and provides intelligent code review with risk analysis",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "pr-review": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "server": "tsx src/server.ts",
    "cli": "tsx src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/"
  },
  "keywords": ["pr-review", "code-review", "ai", "github", "pull-request", "automation"],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "express": "^4.21.0",
    "ora": "^8.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}