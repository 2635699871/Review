# =============================================================================
# API Keys — set at least ONE provider
# =============================================================================

# Anthropic Claude (recommended — native prompt caching + thinking mode)
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# DeepSeek (cost-effective, default provider)
# Get key: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-...

# Google Gemini
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq
# Get key: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Mistral
# Get key: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Together AI
# Get key: https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=

# xAI Grok
# Get key: https://console.x.ai
XAI_API_KEY=

# Moonshot (Kimi)
# Get key: https://platform.moonshot.ai
MOONSHOT_API_KEY=

# Qwen / DashScope (Alibaba)
# Get key: https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=

# ZhipuAI (GLM)
# Get key: https://open.bigmodel.cn
ZHIPUAI_API_KEY=

# Baichuan (百川)
# Get key: https://platform.baichuan-ai.com
BAICHUAN_API_KEY=

# MiniMax
# Get key: https://platform.minimax.io
MINIMAX_API_KEY=

# Doubao / Ark (豆包 / 火山引擎)
# Get key: https://console.volcengine.com/ark
ARK_API_KEY=

# Cohere
# Get key: https://dashboard.cohere.com/api-keys
CO_API_KEY=

# Perplexity
# Get key: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Custom OpenAI-compatible endpoint
# CUSTOM_API_KEY=
# CUSTOM_BASE_URL=
# CUSTOM_MODEL=

# =============================================================================
# GitHub (optional — required for private repos / posting reviews)
# =============================================================================

# Generate at: https://github.com/settings/tokens
# Scopes: repo (private repos) or public_repo (public repos only)
GITHUB_TOKEN=ghp_...

# =============================================================================
# Server (optional)
# =============================================================================

# Web UI port (default: 3300)
PORT=3300
